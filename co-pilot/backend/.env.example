# =============================================================================
# GovPilot Backend - Environment Variables
# Copy this file to .env inside the backend/ folder
# =============================================================================

# Database - SQLite (default local) or PostgreSQL (for Render/production)
# Local:      sqlite:///./govpilot.db
# Production: postgresql://user:password@host:5432/govpilot
DATABASE_URL=sqlite:///./govpilot.db

# CORS - comma-separated list of allowed frontend origins
# Local:      *
# Production: https://govpilot-frontend.onrender.com
FRONTEND_URL=*

# n8n Translation Agent Webhook URL
N8N_TRANSLATION_WEBHOOK_URL=https://your-n8n-instance.com/webhook/translation-agent
