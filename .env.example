# =============================================================================
# GovPilot Frontend - Environment Variables
# Copy this file to .env and fill in your values
# All VITE_ prefixed variables are embedded in the client bundle at build time
# =============================================================================

# Backend API URL (set to your Render backend URL in production)
VITE_API_URL=http://localhost:8000

# Gemini AI API Key (used for complaint categorisation and document AI)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Google Maps / Places API Key (optional - for map features)
VITE_GOOGLE_API_KEY=your-google-api-key-here
